# Copy this file to .env and fill in values locally. Never commit .env.
# The account prefix, e.g. nerds for https://nerds.simplicate.com.
# The API uses https://<subdomain>.simplicate.nl/api/v2.
SIMPLICATE_SUBDOMAIN=nerds
SIMPLICATE_API_KEY=your-simplicate-api-key
SIMPLICATE_API_SECRET=your-simplicate-api-secret

# Find this with: bin/rails simplicate:organizations
SIMPLICATE_ORGANIZATION_ID=

# Used only when the frontend does not use the Vite development proxy.
FRONTEND_ORIGINS=http://localhost:5173
