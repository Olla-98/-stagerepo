# Simplicate API v2 credentials. Keep real values in .env or a secret store.
SIMPLICATE_SUBDOMAIN=
SIMPLICATE_API_KEY=
SIMPLICATE_API_SECRET=

# Weekly schedule should run after your organization's submission deadline.
# The command checks the previous Monday-Sunday week.
TIMEZONE=Europe/Amsterdam
DATABASE_PATH=var/reminders.sqlite3
REMINDER_EMPLOYEE_IDS=

# Sending is disabled unless explicitly enabled.
SEND_REMINDERS=false
REMINDER_FROM=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true
